# ==============================================================================
# ChoreCraft (PromptWars) — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local in the root directory:
#   d:\PromptWars\.env.local
#
# Once created, fill in your real API keys and credentials below.
# The application automatically detects and uses them immediately.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI LLM Provider Configuration
# ------------------------------------------------------------------------------
# Choose "gemini" (recommended) or "groq".
AI_PROVIDER=gemini

# Google Gemini API Key (Get free key in 1 click at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Alternative: Groq API Key (Get at: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. Google Sheets Configuration (for Expense Tracker & Financial AI Chatbot)
# ------------------------------------------------------------------------------
# The ID of your Google Sheet. Found in the Google Sheet URL between /d/ and /edit:
# Example: https://docs.google.com/spreadsheets/d/1xYzABC123DEF456/edit
# In that URL, your GOOGLE_SHEET_ID is: 1xYzABC123DEF456
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ------------------------------------------------------------------------------
# 3. Google Service Account Credentials (for Gmail API & Google Sheets API)
# ------------------------------------------------------------------------------
# Create a Service Account in Google Cloud Console (IAM & Admin -> Service Accounts),
# create a JSON Key, and copy the client_email and private_key from the downloaded JSON file:
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com

# Copy the exact "private_key" string from the JSON file including BEGIN/END markers:
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. Email Account to Track & Analyze
# ------------------------------------------------------------------------------
# The target Gmail email address to analyze and fetch unread primary messages from:
DEMO_GMAIL_ADDRESS=your.email@gmail.com

# ------------------------------------------------------------------------------
# 5. Application Server Configuration
# ------------------------------------------------------------------------------
PORT=8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
