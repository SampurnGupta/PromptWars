# ==============================================================================
# PromptWars — Environment Variables Configuration
# Copy this file to .env.local for local development.
# Never commit real credentials or secret keys to version control.
# ==============================================================================

# AI Model Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
AI_PROVIDER=gemini # Options: "gemini" | "groq"

# Demo Mode & Integration Toggles
# In demo mode, realistic sample data & simulated external API execution are active
# when live Google credentials are not yet configured.
DEMO_MODE=true

# Google Service Account / OAuth (for Gmail & Sheets sync)
GOOGLE_SERVICE_ACCOUNT_EMAIL=demo-account@promptwars-prod.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1xYz_your_google_sheet_id_here
DEMO_GMAIL_ADDRESS=demo.promptwars@gmail.com

# Deployment & Port
PORT=8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

